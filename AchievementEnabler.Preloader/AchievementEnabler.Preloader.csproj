<Project Sdk="Microsoft.NET.Sdk">

  <!--
    AchievementEnabler.Preloader is a BepInEx *patcher*, not a plugin. It must be deployed to
    BepInEx/patchers/ (NOT BepInEx/plugins/): its Patch(AssemblyDefinition) runs while BepInEx is
    loading assembly_valheim, which is the only point at which a *field read* can be changed.
    Harmony can patch a method; it cannot patch `ldsfld Game::isModded`.

    The version below is informational. The single source of truth for a release is the
    PluginVersion const in ../AchievementEnabler/AchievementEnabler.cs, which is what
    `mod-tools check` compares against the Thunderstore manifest and the git tag.
  -->

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net48</TargetFramework>
    <RootNamespace>AchievementEnabler.Preloader</RootNamespace>
    <AssemblyName>AchievementEnabler.Preloader</AssemblyName>
    <LangVersion>10</LangVersion>
    <Nullable>disable</Nullable>
    <Deterministic>true</Deterministic>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <Version>0.2.0</Version>
    <Description>BepInEx patcher that rewrites Valheim's modded-flag reads so achievement gating sees an unmodded game.</Description>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
    <DefineConstants>DEBUG;TRACE</DefineConstants>
    <Optimize>false</Optimize>
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
    <Optimize>true</Optimize>
    <DebugType>pdbonly</DebugType>
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>

  <!--
    Reference BepInEx's OWN Mono.Cecil, not the NuGet package. BepInEx 5.4.23.3 ships Cecil
    0.10.4 and hands us an AssemblyDefinition built by it; compiling against NuGet's 0.11.x
    would mean our Cecil types are not the runtime's Cecil types. (ValheimMonitor.Preloader in
    this same mod family gets away with the NuGet reference only because its TargetDLLs is empty
    and its Patch method is never actually called.)

    Everything here is supplied at runtime by BepInEx, hence Private=false throughout.

    Deliberately NOT referenced: assembly_valheim and any UnityEngine assembly. During the
    preloader phase, touching a type whose graph reaches UnityEngine forces UnityEngine.CoreModule
    to load before BepInEx has injected its Chainloader hook into it, which breaks the bootstrap.
    This project works purely on Cecil's model of the game assembly and never loads it.
  -->
  <ItemGroup>
    <Reference Include="BepInEx">
      <HintPath>$(BEPINEX_PATH)\core\BepInEx.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Mono.Cecil">
      <HintPath>$(BEPINEX_PATH)\core\Mono.Cecil.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- Mirrors the plugin's CopyToModManagers, but into patchers/<Name>/ and into the Thunderstore
       payload. Runs on every configuration: a Debug build is meant to land in the test profile. -->
  <Target Name="DeployPatcher" AfterTargets="Build">
    <ItemGroup>
      <PatcherDeployDir Include="$(AppData)\com.kesomannen.gale\valheim\profiles\Modtest\BepInEx\patchers\AchievementEnabler\" />
      <PatcherDeployDir Include="$(AppData)\r2modmanPlus-local\Valheim\profiles\Modtest\BepInEx\patchers\AchievementEnabler\" />
      <PatcherDeployDir Include="$(AppData)\Thunderstore Mod Manager\DataFolder\Valheim\profiles\Modtesting\BepInEx\patchers\AchievementEnabler\" />
      <PatcherDeployDir Include="$(SolutionDir)AchievementEnabler\Package\patchers\AchievementEnabler\" />
    </ItemGroup>
    <Copy SourceFiles="$(TargetDir)$(TargetFileName)" DestinationFolder="%(PatcherDeployDir.Identity)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(TargetDir)$(AssemblyName).pdb" DestinationFolder="%(PatcherDeployDir.Identity)" SkipUnchangedFiles="true" Condition="Exists('$(TargetDir)$(AssemblyName).pdb')" />
  </Target>

</Project>
